# Copy to .env and fill in. Options come from the environment, then .env, then defaults.

# Required. Bot token from the Discord Developer Portal (Bot -> Token).
DISCORD_BOT_TOKEN=

# Comma-separated server ids to sync slash commands to (instant). Empty = global sync
# (can take up to an hour to appear).
GUILD_IDS=

# Comma-separated services to run. Available: lookup
ENABLED_SERVICES=lookup

# Required. Path to a WRFrontiersDB-Data clone.
DATA_DIR=

# Site the bot links to, and where to read its slug map (URL or file path).
SITE_URL=https://wrf-db.info
SITE_SLUG_MAP_SOURCE=https://wrf-db.info/slug_map.json

# How often to check DATA_DIR and the slug map for changes.
DATA_REFRESH_MINUTES=10

# TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
