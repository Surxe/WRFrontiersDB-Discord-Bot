# Copy to .env and fill in. Options come from the environment, then .env, then defaults.

# Required. Bot token from the Discord Developer Portal (Bot -> Token).
DISCORD_BOT_TOKEN=

# Comma-separated server ids to sync slash commands to (instant). Empty = global sync
# (can take up to an hour to appear).
GUILD_IDS=

# Comma-separated services to run. Available: lookup, about
ENABLED_SERVICES=lookup

# Required. Path to a WRFrontiersDB-Data clone.
DATA_DIR=

# Site the bot links to. Page slugs come from DATA_DIR's index/slug_map.json.
SITE_URL=https://wrf-db.info

# Optional. The pipeline's Site deploy record (WRFrontiersDB-Orchestrator's
# data/site_deploy_state.json). Embed descriptions come from SITE_URL/meta_descriptions.json,
# fetched at startup and again after each deploy recorded here. Unset = startup only.
SITE_DEPLOY_STATE=

# The Discount Visualizer, for /about (which Data commit it serves, from its /deploy.json).
VISUALIZER_URL=https://surxe.github.io/WRFrontiers-Discount-Visualizer

# How often to check DATA_DIR, the slug map and SITE_DEPLOY_STATE for changes.
DATA_REFRESH_MINUTES=10

# TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
